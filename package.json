{
  "name": "unhooked",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch build.ts",
    "build": "NODE_ENV=production bun build.ts all",
    "build:chrome": "NODE_ENV=production bun build.ts chrome",
    "build:firefox": "NODE_ENV=production bun build.ts firefox",
    "build:safari": "NODE_ENV=production bun build.ts safari",
    "package": "NODE_ENV=production bun scripts/package.ts",
    "package:firefox:review": "NODE_ENV=production FIREFOX_FOR_REVIEW=1 bun scripts/package.ts firefox",
    "icons": "bun scripts/create-icons.ts",
    "test": "bun test src build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint -c .oxlintrc.json build.ts build src e2e scripts",
    "format": "oxfmt -c .oxfmtrc.json --write build.ts build src e2e scripts package.json",
    "format:check": "oxfmt -c .oxfmtrc.json --check build.ts build src e2e scripts package.json",
    "check": "bun run typecheck && bun run lint && bun run format:check",
    "e2e": "bun e2e/run.mjs",
    "e2e:chrome": "bun e2e/run.mjs chrome",
    "e2e:firefox": "bun e2e/run.mjs firefox"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "@types/chrome": "0.1.38",
    "@types/firefox-webext-browser": "^143.0.0",
    "fflate": "^0.8.3",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.57.0",
    "puppeteer-core": "^25.12.0",
    "typescript": "^6.0.2"
  }
}
