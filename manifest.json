{
  "manifest_version": 3,
  "name": "Unhooked",
  "version": "0.1.0",
  "description": "Hide YouTube recommendations, Shorts, comments, and other distractions. Unofficial, not affiliated with YouTube or Google.",
  "permissions": ["storage"],
  "host_permissions": [
    "*://www.youtube.com/*",
    "*://m.youtube.com/*",
    "*://www.youtube-nocookie.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Unhooked"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*",
        "*://www.youtube-nocookie.com/*"
      ],
      "css": ["content/styles.css"],
      "js": ["shared/options.js", "content/content.js"],
      "run_at": "document_start"
    }
  ]
}
